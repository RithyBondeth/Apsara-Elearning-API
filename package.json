{
  "name": "apsara-elearning-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "build:api": "nest build api-gateway",
    "build:admin": "nest build admin-gateway",
    "build:auth": "nest build auth-service",
    "build:user": "nest build user-service",
    "build:course": "nest build course-service",
    "build:assessment": "nest build assessment-service",
    "build:ai": "nest build ai-service",
    "build:subscription": "nest build subscription-service",
    "build:all": "npm run build:api && npm run build:admin && npm run build:auth && npm run build:user && npm run build:course && npm run build:assessment && npm run build:ai && npm run build:subscription",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:dev:api": "nest start api-gateway --watch",
    "start:dev:admin": "nest start admin-gateway --watch",
    "start:dev:auth": "nest start auth-service --watch",
    "start:dev:user": "nest start user-service --watch",
    "start:dev:course": "nest start course-service --watch",
    "start:dev:assessment": "nest start assessment-service --watch",
    "start:dev:ai": "nest start ai-service --watch",
    "start:dev:subscription": "nest start subscription-service --watch",
    "start:all": "concurrently \"npm run start:dev:api\" \"npm run start:dev:admin\" \"npm run start:dev:auth\" \"npm run start:dev:user\" \"npm run start:dev:course\" \"npm run start:dev:assessment\" \"npm run start:dev:ai\" \"npm run start:dev:subscription\"",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/api-gateway/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./apps/api-gateway/test/jest-e2e.json",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "dev": "bash scripts/dev.sh",
    "start:prod:all": "bash scripts/prod.sh",
    "seed": "node scripts/seed.mjs",
    "db:baseline": "node scripts/baseline-migrations.mjs",
    "db:generate": "drizzle-kit generate --config=libs/database/src/config/drizzle.config.ts",
    "db:push": "drizzle-kit push --config=libs/database/src/config/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=libs/database/src/config/drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=libs/database/src/config/drizzle.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.2",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.1.24",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^2.0.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.11.1",
    "joi": "^18.2.1",
    "nestjs-pino": "^4.6.1",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.12.4",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "concurrently": "^10.0.3",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.8.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@app/common(|/.*)$": "<rootDir>/libs/common/src/$1",
      "^@app/contracts(|/.*)$": "<rootDir>/libs/contracts/src/$1",
      "^@app/database(|/.*)$": "<rootDir>/libs/database/src/$1"
    }
  }
}
