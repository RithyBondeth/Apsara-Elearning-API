# =========================================================
# Apsara Elearning API — environment template. Copy to .env and fill in.
# =========================================================

NODE_ENV=development

# --- Database (Neon Postgres) ---
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
DATABASE_SYNCHRONIZE=false

# --- JWT ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES=7d
JWT_EMAIL_EXPIRES=1h
BCRYPT_SALT=10

# --- Gateways ---
API_GATEWAY_PORT=1111
ADMIN_GATEWAY_PORT=2222

# --- RabbitMQ (matches docker-compose.yml defaults) ---
RABBITMQ_URL=amqp://admin:admin123@localhost:5672
AUTH_QUEUE=auth_queue
USER_QUEUE=user_queue
COURSE_QUEUE=course_queue
ASSESSMENT_QUEUE=assessment_queue
SUBSCRIPTION_QUEUE=subscription_queue
AI_QUEUE=ai_queue

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# --- AI tutor (Anthropic) — optional; mock replies if unset ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- Code execution (Judge0) — optional; mock grading if unset ---
JUDGE0_URL=
JUDGE0_TOKEN=

# --- Security (optional) ---
# Comma-separated allowed CORS origins; '*' (open) if unset.
CORS_ORIGINS=
# Shared secret for the payment webhook (x-webhook-secret header); check skipped if unset.
WEBHOOK_SECRET=
# Redis URL for distributed rate limiting; in-memory if unset (fine for single instance).
REDIS_URL=
