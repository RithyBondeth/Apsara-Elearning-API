# =========================================================
# Apsara Elearning API — environment template. Copy to .env and fill in.
# =========================================================

NODE_ENV=development

# --- Database (Local Docker Postgres) ---
DATABASE_URL=postgresql://apsara:apsara123@localhost:5432/apsara_elearning
DATABASE_SYNCHRONIZE=false

# --- JWT ---
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
JWT_REFRESH_EXPIRES=7d
JWT_ACTION_SECRET=replace-with-a-third-random-32-character-secret
JWT_ISSUER=apsara-elearning
JWT_AUDIENCE=apsara-elearning-web
JWT_EMAIL_EXPIRES=1h
BCRYPT_SALT=12

# --- Gateways ---
API_GATEWAY_PORT=1111
ADMIN_GATEWAY_PORT=2222

# --- RabbitMQ (matches docker-compose.yml defaults) ---
RABBITMQ_URL=amqp://admin:admin123@localhost:5672
AUTH_QUEUE=auth_queue
USER_QUEUE=user_queue
COURSE_QUEUE=course_queue
ASSESSMENT_QUEUE=assessment_queue
SUBSCRIPTION_QUEUE=subscription_queue
AI_QUEUE=ai_queue

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
SUPPORT_TO_EMAIL=

# --- AI tutor (Anthropic) — optional; mock replies if unset ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# --- Code execution (Judge0) — optional; mock grading if unset ---
JUDGE0_URL=
JUDGE0_TOKEN=

# --- Security ---
# Required in production. Comma-separated, exact browser origins.
CORS_ORIGINS=http://localhost:3000
# Required by subscription-service in production. Use Stripe test keys locally.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
WEB_APP_URL=http://localhost:3000
# Redis URL for distributed rate limiting; in-memory if unset (fine for single instance).
REDIS_URL=
